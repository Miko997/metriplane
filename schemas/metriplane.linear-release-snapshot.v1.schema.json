          "$ref": "#/$defs/identity"
        },
        "index_observation_ids": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "parent": {
          "oneOf": [
            {
              "$ref": "#/$defs/relation"
            },
            {
              "type": "null"
            }
          ]
        },
        "project_milestone": {
          "oneOf": [
            {
              "$ref": "#/$defs/milestone_identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "related_to": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "started_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "title": {
          "minLength": 1,
          "type": "string"
        },
        "updated_at": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "identity",
        "title",
        "description",
        "project_milestone",
        "parent",
        "state",
        "assignee_ids",
        "created_at",
        "updated_at",
        "archived_at",
        "completed_at",
        "started_at",
        "canceled_at",
        "blocks",
        "blocked_by",
        "related_to",
        "duplicate_of",
        "detail_observation_id",
        "index_observation_ids"
