          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "blocked_by": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "blocks": {
          "items": {
            "$ref": "#/$defs/relation"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
