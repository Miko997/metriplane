      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
