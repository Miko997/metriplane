            {
              "type": "null"
            }
          ]
        },
        "catalog_task_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/catalog_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "inclusion_reasons": {
          "items": {
            "enum": [
              "cumulative_catalog",
              "prior_roadmap_decision",
              "current_decision",
              "context_direct_gate",
              "blocking_dependency"
