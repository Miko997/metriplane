        "name",
        "project_id"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "type": "string"
    },
    "observation": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "mcp__codex_apps__linear_list_issues"
              }
            },
            "required": [
              "tool"
