                  "id",
                  "includeRelations"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "mcp__codex_apps__linear_list_issue_statuses"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "team": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "required": [
                  "team"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "mcp__codex_apps__linear_list_milestones"
              }
            },
            "required": [
              "tool"
            ]
          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "project": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "required": [
                  "project"
                ],
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "arguments": {},
        "capture_status": {
          "const": "SUCCESS"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "extracted_json_pointer": {
          "type": "string"
        },
        "id": {
          "minLength": 1,
          "type": "string"
