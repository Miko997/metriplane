          },
          "then": {
            "properties": {
              "arguments": {
                "additionalProperties": false,
                "properties": {
                  "cursor": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "fields": {
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  },
                  "includeArchived": {
                    "const": true
                  },
                  "limit": {
                    "const": 250
                  },
                  "orderBy": {
                    "const": "createdAt"
                  },
                  "project": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "required": [
                  "project",
                  "includeArchived",
                  "limit",
                  "orderBy",
                  "fields"
                ],
                "type": "object"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "mcp__codex_apps__linear_get_issue"
