        "catalog_first_required_release",
        "role",
        "inclusion_reasons",
        "issue"
      ],
      "type": "object"
    },
    "catalog_id": {
      "pattern": "^MP2-[0-9]{3}$",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
