        "tool",
        "arguments",
        "started_at",
        "completed_at",
        "response",
        "extracted_json_pointer",
        "capture_status",
        "payload_encoding"
      ],
      "type": "object"
    },
    "package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "project_milestones": {
      "additionalProperties": false,
