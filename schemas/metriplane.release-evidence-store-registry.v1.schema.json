    "binding_ref": {
      "additionalProperties": false,
      "properties": {
        "backend_id": {
          "$ref": "#/$defs/text"
        },
        "binding_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "backend_id",
        "binding_digest"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "live_binding": {
      "additionalProperties": false,
      "properties": {
        "adapter_id": {
          "$ref": "#/$defs/text"
        },
        "administration_identity": {
          "$ref": "#/$defs/raw_file"
        },
        "durability_retention_policy": {
          "$ref": "#/$defs/raw_file"
        },
        "namespace_policy": {
          "$ref": "#/$defs/raw_file"
        },
        "owner_binding_authority": {
          "$ref": "#/$defs/raw_file"
        },
        "provider_resource_identity": {
          "$ref": "#/$defs/raw_file"
        },
        "public_configuration": {
          "$ref": "#/$defs/raw_file"
        }
      },
      "required": [
        "adapter_id",
        "public_configuration",
        "owner_binding_authority",
        "provider_resource_identity",
        "administration_identity",
        "durability_retention_policy",
        "namespace_policy"
      ],
      "type": "object"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "text": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    }
  },
