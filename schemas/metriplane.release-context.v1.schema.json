{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "git_oid": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "historical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "issue_identifier": {
      "pattern": "^[A-Z][A-Z0-9]*-[1-9][0-9]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "milestone": {
      "enum": [
        "v0.4",
        "v0.5",
        "v0.6",
        "v0.7",
        "v0.8",
        "v0.9",
        "v1.0"
      ]
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "bytes",
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "uuid": {
      "format": "uuid",
      "type": "string"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-context.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Proposed upstream context wire. It binds a governed registry entry and complete frozen project evidence to a release target and comparison baseline. It is not a publication approval or a predecessor success record.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "comparison_baseline": {
          "additionalProperties": false,
          "properties": {
            "artifacts": {
              "allOf": [
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "wheel"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "maxContains": 1,
                  "minContains": 1
                },
                {
                  "contains": {
                    "properties": {
                      "kind": {
                        "const": "sdist"
                      }
                    },
                    "required": [
                      "kind"
                    ]
                  },
                  "maxContains": 1,
                  "minContains": 1
                }
              ],
              "items": {
                "additionalProperties": false,
                "properties": {
                  "bytes": {
                    "minimum": 1,
                    "type": "integer"
                  },
                  "filename": {
                    "$ref": "#/$defs/nonempty"
                  },
                  "kind": {
                    "enum": [
                      "wheel",
                      "sdist"
                    ]
                  },
                  "readback": {
                    "$ref": "#/$defs/raw_file"
                  },
                  "sha256": {
                    "$ref": "#/$defs/digest"
                  }
                },
                "required": [
                  "bytes",
                  "filename",
                  "kind",
                  "readback",
                  "sha256"
                ],
                "type": "object"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "normalized_package_version": {
              "$ref": "#/$defs/historical_package_version"
            },
            "release_observation": {
              "$ref": "#/$defs/raw_file"
            },
            "release_tag": {
              "$ref": "#/$defs/nonempty"
            },
            "source_commit": {
              "$ref": "#/$defs/git_oid"
            },
            "source_tree": {
              "$ref": "#/$defs/git_oid"
            },
            "tag_object": {
              "$ref": "#/$defs/git_oid"
            },
            "tag_observation": {
              "$ref": "#/$defs/raw_file"
            }
          },
          "required": [
            "artifacts",
            "normalized_package_version",
            "release_observation",
            "release_tag",
            "source_commit",
            "source_tree",
            "tag_object",
            "tag_observation"
          ],
          "type": "object"
        },
        "context_digest": {
          "$ref": "#/$defs/digest"
        },
        "context_id": {
          "$ref": "#/$defs/nonempty"
        },
        "context_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "cumulative_bom_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "decision": {
          "additionalProperties": false,
          "properties": {
            "issue_id": {
              "$ref": "#/$defs/uuid"
            },
            "issue_identifier": {
              "$ref": "#/$defs/issue_identifier"
            },
            "project_id": {
              "$ref": "#/$defs/uuid"
            },
            "provider": {
              "const": "linear"
            },
            "team_id": {
              "$ref": "#/$defs/uuid"
            }
          },
          "required": [
            "issue_id",
            "issue_identifier",
            "project_id",
            "provider",
            "team_id"
          ],
          "type": "object"
        },
        "direct_gate_issues": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "issue_id": {
                "$ref": "#/$defs/uuid"
              },
              "issue_identifier": {
                "$ref": "#/$defs/issue_identifier"
              },
              "project_id": {
                "$ref": "#/$defs/uuid"
              },
              "provider": {
                "const": "linear"
              },
              "team_id": {
                "$ref": "#/$defs/uuid"
              }
            },
            "required": [
              "issue_id",
              "issue_identifier",
              "project_id",
              "provider",
              "team_id"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "framework_milestone": {
          "$ref": "#/$defs/milestone"
        },
        "linear_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "predecessor_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "predecessor_requirement": {
          "const": "VALIDATE_ORIGINAL_GENESIS_OR_RECONCILED_LKG_GRAPH_UNDER_BOUND_POLICY"
        },
        "provider_milestone": {
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/uuid"
            },
            "name": {
              "$ref": "#/$defs/nonempty"
            },
            "project_id": {
              "$ref": "#/$defs/uuid"
            }
          },
          "required": [
            "id",
            "name",
            "project_id"
          ],
          "type": "object"
        },
        "readiness_registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "roadmap_catalog_task_id": {
          "oneOf": [
            {
              "pattern": "^MP2-[0-9]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "target_policy": {
          "additionalProperties": false,
          "oneOf": [
            {
              "properties": {
                "conflict_disposition": {
                  "const": "BLOCKED_REQUIRES_NEW_OWNER_RELEASE_IDENTITY"
                },
                "resolution_mode": {
                  "const": "owner_approved_exact_target"
                }
              }
            },
            {
              "properties": {
                "conflict_disposition": {
                  "const": "DURABLE_BURN_THEN_SAME_MILESTONE_PATCH"
                },
                "resolution_mode": {
                  "const": "next_unused_same_milestone_patch"
                }
              }
            }
          ],
          "properties": {
            "conflict_disposition": {
              "enum": [
                "BLOCKED_REQUIRES_NEW_OWNER_RELEASE_IDENTITY",
                "DURABLE_BURN_THEN_SAME_MILESTONE_PATCH"
              ]
            },
            "initial_normalized_package_version": {
              "$ref": "#/$defs/package_version"
            },
            "initial_release_tag": {
              "$ref": "#/$defs/nonempty"
            },
            "resolution_mode": {
              "enum": [
                "owner_approved_exact_target",
                "next_unused_same_milestone_patch"
              ]
            }
          },
          "required": [
            "conflict_disposition",
            "initial_normalized_package_version",
            "initial_release_tag",
            "resolution_mode"
          ],
          "type": "object"
        }
      },
      "required": [
        "comparison_baseline",
        "context_digest",
        "context_id",
        "context_policy_digest",
        "cumulative_bom_snapshot_digest",
        "decision",
        "direct_gate_issues",
        "framework_milestone",
        "linear_snapshot_digest",
        "predecessor_policy_digest",
        "predecessor_requirement",
        "provider_milestone",
        "readiness_registry_digest",
        "roadmap_catalog_task_id",
        "target_policy"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-context"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane supplied release-context record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes",
    "context_digest is canonical data excluding only context_digest; context_policy_digest is canonical complete selected registry entry; raw registry digests hash original file bytes",
    "decision, milestone, all direct gate identities and complete cumulative BOM must equal the retained frozen Linear projection and the selected governed registry entry",
    "MET163 context has null roadmap catalog task ID, framework v0.4, exact normalized0.4.1/tagv0.4.1, and post2 comparison baseline; never silently select the old roadmap decision task",
    "exact target policy requires BLOCKED_REQUIRES_NEW_OWNER_RELEASE_IDENTITY; generic next-patch mode requires DURABLE_BURN_THEN_SAME_MILESTONE_PATCH",
    "all safe retained relative file references resolve and rehash; baseline artifacts are exactly one wheel and one sdist; actual annotated tag resolves the declared commit/tree; baseline is never inferred to be an accepted LKG",
    "publication authorization is checked against current owner instructions at the actual action boundary; no frozen context boolean or prior permission authorizes publication",
    "raw file readbacks and registry authority are independently validated; hash-shaped strings, supplied self-authentication or a schema-valid object are not authority"
  ]
}
