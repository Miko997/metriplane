{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriplane.com/schemas/metriplane.supply-chain-policy.v1.schema.json",
  "title": "Metriplane supply-chain policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "owner", "required_controls", "actions", "tool_versions", "python_projects", "additional_locks", "license_review", "osv_runtime_export_directory", "images", "license_files"],
  "properties": {
    "schema_version": {"const": "metriplane.supply-chain-policy.v1"},
    "owner": {"const": "MP2-029"},
    "required_controls": {
      "type": "array",
      "minItems": 6,
      "uniqueItems": true,
      "items": {"enum": ["dependency-review", "osv", "pip-audit", "image-scan", "secret-scan", "sbom"]}
    },
    "actions": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[^@\\s]+@[0-9a-f]{40}$"},
      "required": ["osv", "pip-audit", "image-scan", "secret-scan", "sbom"]
    },
    "tool_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["syft", "trivy", "trufflehog"],
      "properties": {
        "syft": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "trivy": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "trufflehog": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "python_projects": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory", "lock"],
        "properties": {
          "directory": {"type": "string", "minLength": 1},
          "lock": {"type": "string", "pattern": "(^|/)uv\\.lock$"}
        }
      }
    },
    "additional_locks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "(^|/)uv\\.lock$"}
    },
    "license_review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denied_licenses", "index_url", "runtime_baseline_export_directory", "runtime_export_directory"],
      "properties": {
        "denied_licenses": {"const": ["GPL-3.0", "AGPL-3.0"]},
        "index_url": {"const": "https://pypi.org/pypi"},
        "runtime_baseline_export_directory": {"const": ".supply-chain-license-base"},
        "runtime_export_directory": {"const": ".supply-chain-license"}
      }
    },
    "osv_runtime_export_directory": {"const": ".supply-chain-osv"},
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scanned", "excluded"],
      "properties": {
        "scanned": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "Dockerfile$"}
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "reason"],
            "properties": {
              "path": {"type": "string", "pattern": "Dockerfile$"},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "license_files": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
