{
  "$comment": "Prospective S3A supplied-input/schema projection. No native implementation, live approval or release qualification is claimed.",
  "$defs": {
    "canonical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "historical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "historical_release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "record_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-evidence-store.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "signatures": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-evidence-store. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "binding_status": {
                "const": "UNRESOLVED"
              }
            },
            "required": [
              "binding_status"
            ]
          },
          "then": {
            "properties": {
              "backend_binding_digest": {
                "type": "null"
              },
              "generation_token": {
                "type": "null"
              },
              "original_preflight": {
                "type": "null"
              },
              "preflight_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_status": {
                "const": "BOUND_CONFIGURED"
              }
            },
            "required": [
              "binding_status"
            ]
          },
          "then": {
            "properties": {
              "backend_binding_digest": {
                "$ref": "#/$defs/digest"
              },
              "generation_token": {
                "type": "null"
              },
              "original_preflight": {
                "type": "null"
              },
              "preflight_digest": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "binding_status": {
                "const": "PREFLIGHT_VALIDATED"
              }
            },
            "required": [
              "binding_status"
            ]
          },
          "then": {
            "properties": {
              "backend_binding_digest": {
                "$ref": "#/$defs/digest"
              },
              "generation_token": {
                "$ref": "#/$defs/nonempty"
              },
              "original_preflight": {
                "additionalProperties": false,
                "properties": {
                  "original_file": {
                    "$ref": "#/$defs/record_file"
                  },
                  "record_digest": {
                    "$ref": "#/$defs/digest"
                  },
                  "record_type": {
                    "const": "release-evidence-store-preflight"
                  }
                },
                "required": [
                  "record_type",
                  "record_digest",
                  "original_file"
                ],
                "type": "object"
              },
              "preflight_digest": {
                "$ref": "#/$defs/digest"
              }
            }
          }
        }
      ],
      "properties": {
        "backend_binding_digest": {
          "$ref": "#/$defs/nullable_digest"
        },
        "backend_kind": {
          "enum": [
            "immutable_payload",
            "compare_and_swap_log",
            "compare_and_swap_register"
          ]
        },
        "binding_status": {
          "enum": [
            "UNRESOLVED",
            "BOUND_CONFIGURED",
            "PREFLIGHT_VALIDATED"
          ]
        },
        "capabilities": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "consistency_model": {
          "$ref": "#/$defs/nonempty"
        },
        "credential_reference": {
          "$ref": "#/$defs/identifier"
        },
        "generation_token": {
          "oneOf": [
            {
              "$ref": "#/$defs/nonempty"
            },
            {
              "type": "null"
            }
          ]
        },
        "logical_backend_id": {
          "enum": [
            "payload-store-a",
            "payload-store-b",
            "attempt-index",
            "success-chain",
            "last-known-good",
            "main-health-state",
            "main-health-summary"
          ]
        },
        "namespace": {
          "$ref": "#/$defs/nonempty"
        },
        "namespace_kind": {
          "enum": [
            "production",
            "preflight",
            "test"
          ]
        },
        "original_preflight": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "original_file": {
                  "$ref": "#/$defs/record_file"
                },
                "record_digest": {
                  "$ref": "#/$defs/digest"
                },
                "record_type": {
                  "const": "release-evidence-store-preflight"
                }
              },
              "required": [
                "record_type",
                "record_digest",
                "original_file"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "original_registry": {
          "$ref": "#/$defs/record_file"
        },
        "preflight_digest": {
          "$ref": "#/$defs/nullable_digest"
        },
        "registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "retention_policy_digest": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "backend_binding_digest",
        "backend_kind",
        "binding_status",
        "capabilities",
        "consistency_model",
        "credential_reference",
        "generation_token",
        "logical_backend_id",
        "namespace",
        "namespace_kind",
        "original_preflight",
        "original_registry",
        "preflight_digest",
        "registry_digest",
        "retention_policy_digest"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-evidence-store"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "PASS"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-evidence-store record",
  "type": "object",
  "x-metriplane-origin": {
    "kind": "SUPPLIED_EXISTING_OWNER_RECORD",
    "producer": null,
    "production_implementation": false,
    "stage": null,
    "terminal_digest_in_output": false
  },
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes"
  ],
  "x-metriplane-semantic-contract": "semantic-contract.md; full current controller integration and original native proof replay required; structure alone is insufficient"
}
