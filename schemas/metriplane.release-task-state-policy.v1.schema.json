          },
          "maxItems": 3,
          "minItems": 3,
          "type": "array",
          "uniqueItems": true
        },
        "terminal_commit_clock_skew_seconds": {
          "const": 30
        },
        "terminal_freshness_seconds": {
          "const": 120
        },
        "transition_role": {
          "const": "release_operator"
        }
      },
      "required": [
