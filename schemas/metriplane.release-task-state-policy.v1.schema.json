  "$id": "https://metriplane.com/schemas/metriplane.release-task-state-policy.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-task-state-policy. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "allowed_transitions": {
          "items": {
            "$ref": "#/$defs/transition"
          },
          "maxItems": 2,
          "minItems": 2,
          "type": "array",
          "uniqueItems": true
        },
        "capture_clock_skew_seconds": {
          "const": 30
        },
        "close_role": {
          "const": "release_operator"
        },
        "cross_system_atomicity": {
          "const": "not_claimed"
        },
        "policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepromotion_freshness_seconds": {
          "const": 300
        },
        "provider": {
          "const": "linear"
        },
        "states": {
