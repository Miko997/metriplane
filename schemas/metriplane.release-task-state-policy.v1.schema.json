      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-task-state-policy"
    },
    "schema_version": {
