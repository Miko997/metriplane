{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal payload_digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-protected-input.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-protected-input. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_role": {
          "enum": [
            "release_operator",
            "non_author_reviewer",
            "infrastructure_owner",
            "publisher",
            "independent_assurance_verifier"
          ]
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "decision": {
          "$ref": "#/$defs/nonempty"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "input_kind": {
          "enum": [
            "role_assignment",
            "approval_decision",
            "task_state_transition",
            "index_abandonment",
            "promotion_lock_recovery",
            "assurance_attestation",
            "impact_classification",
            "lkg_invalidation"
          ]
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provider_event": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "actor_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "after_state_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "api_version": {
                  "$ref": "#/$defs/nonempty"
                },
                "before_state_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "event_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "provider": {
                  "enum": [
                    "github",
                    "linear"
                  ]
                },
                "server_timestamp": {
                  "$ref": "#/$defs/timestamp"
                }
              },
              "required": [
                "actor_id",
                "after_state_id",
                "api_version",
                "before_state_id",
                "event_id",
                "provider",
                "server_timestamp"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "signer_identity": {
          "$ref": "#/$defs/nonempty"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "subject_digests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "subject": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "sha256",
              "subject"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "authority_policy_digest",
        "authorized_role",
        "conflicts",
        "decision",
        "expires_at",
        "input_kind",
        "issued_at",
        "provider_event",
        "signer_identity",
        "signing_method",
        "subject_digests"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-protected-input"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-protected-input record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == payload_digest",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
