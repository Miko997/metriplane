                    "type": "null"
                  }
                }
              }
            }
          },
          "if": {
            "properties": {
              "assignments": {
                "properties": {
                  "milestone": {
                    "enum": [
                      "v0.9",
                      "v1.0"
                    ]
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "role_provenance_files": {
                "properties": {
                  "independent_assurance": {
                    "$ref": "#/$defs/raw_file"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "assignment_kind": {
          "const": "protected_release_roles"
        },
        "assignment_payload_digest": {
          "$ref": "#/$defs/digest"
        },
        "assignment_policy_registry": {
          "$ref": "#/$defs/raw_file"
        },
        "assignments": {
          "$ref": "#/$defs/role_assignment_payload"
        },
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_role": {
          "const": "release_operator"
        },
        "conflicts": {
          "const": []
        },
        "decision": {
          "const": "ASSIGNED"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "input_kind": {
          "const": "role_assignment"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provider_attestation_keyring_digest": {
          "$ref": "#/$defs/digest"
        },
        "release_context": {
          "$ref": "#/$defs/raw_file"
        },
        "role_provenance_files": {
          "$ref": "#/$defs/role_provenance_files"
        },
        "signer_identity": {
          "$ref": "#/$defs/nonempty"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "subject_digests": {
          "items": false,
          "maxItems": 3,
          "minItems": 3,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "assignment_payload"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "release_context"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "assignment_policy_registry"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      },
      "required": [
        "input_kind",
        "assignment_kind",
        "decision",
        "authorized_role",
        "conflicts",
        "signer_identity",
        "signing_method",
        "issued_at",
        "expires_at",
        "authority_policy_digest",
        "provider_attestation_keyring_digest",
        "assignments",
        "assignment_payload_digest",
        "release_context",
        "assignment_policy_registry",
        "role_provenance_files",
        "subject_digests"
      ],
      "type": "object"
    },
    "role_assignment_payload": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "independent_assurance": {
                "additionalProperties": false,
                "properties": {
                  "applicability": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "applicability"
                ],
                "type": "object"
              }
            }
          },
          "if": {
            "properties": {
              "milestone": {
                "enum": [
                  "v0.9",
                  "v1.0"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "independent_assurance": {
                "properties": {
                  "applicability": {
                    "const": "required"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "author_id": {
          "$ref": "#/$defs/nonempty"
        },
        "author_provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_executor_id": {
          "$ref": "#/$defs/nonempty"
