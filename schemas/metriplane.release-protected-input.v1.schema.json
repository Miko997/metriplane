          "$ref": "#/$defs/digest"
        },
        "authorized_role": {
          "enum": [
            "release_operator",
            "non_author_reviewer",
            "infrastructure_owner",
            "publisher",
            "independent_assurance_verifier"
          ]
        },
        "conflicts": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "decision": {
          "$ref": "#/$defs/nonempty"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "input_kind": {
          "enum": [
            "role_assignment",
            "approval_decision",
            "task_state_transition",
            "index_abandonment",
            "promotion_lock_recovery",
            "assurance_attestation",
            "impact_classification",
            "lkg_invalidation",
            "index_recovery"
          ]
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "provider_event": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "actor_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "after_state_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "api_version": {
                  "$ref": "#/$defs/nonempty"
                },
                "before_state_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "event_id": {
                  "$ref": "#/$defs/nonempty"
                },
                "provider": {
                  "enum": [
                    "github",
                    "linear"
                  ]
                },
                "server_timestamp": {
                  "$ref": "#/$defs/timestamp"
                }
              },
              "required": [
                "actor_id",
                "after_state_id",
                "api_version",
                "before_state_id",
                "event_id",
                "provider",
                "server_timestamp"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "signer_identity": {
          "$ref": "#/$defs/nonempty"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "subject_digests": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "$ref": "#/$defs/digest"
              },
              "subject": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "sha256",
              "subject"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "authority_policy_digest",
        "authorized_role",
        "conflicts",
        "decision",
        "expires_at",
        "input_kind",
        "issued_at",
        "provider_event",
        "signer_identity",
        "signing_method",
        "subject_digests"
      ],
      "type": "object"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "role_assignment_authorization_data": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "role_provenance_files": {
