{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "closed_provider_event": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "after_state_id": {
          "$ref": "#/$defs/uuid"
        },
        "after_state_key": {
          "const": "closed"
        },
        "api_version": {
          "$ref": "#/$defs/nonempty"
        },
        "before_state_id": {
          "$ref": "#/$defs/uuid"
        },
        "before_state_key": {
          "const": "open_finalizing"
        },
        "event_id": {
          "$ref": "#/$defs/nonempty"
        },
        "issue_id": {
          "$ref": "#/$defs/uuid"
        },
        "issue_identifier": {
          "pattern": "^MET-[0-9]+$",
          "type": "string"
        },
        "project_id": {
          "$ref": "#/$defs/uuid"
        },
        "provider": {
          "const": "linear"
        },
        "server_timestamp": {
          "$ref": "#/$defs/timestamp"
        },
        "team_id": {
          "$ref": "#/$defs/uuid"
        }
      },
      "required": [
        "provider",
        "api_version",
        "team_id",
        "project_id",
        "issue_id",
        "issue_identifier",
        "event_id",
        "actor_id",
        "before_state_id",
        "after_state_id",
        "before_state_key",
        "after_state_key",
        "server_timestamp"
      ],
      "type": "object"
    },
    "closed_transition_data": {
      "additionalProperties": false,
      "properties": {
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_role": {
          "const": "release_operator"
        },
        "conflicts": {
          "const": []
        },
        "decision": {
          "const": "CLOSED"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "input_kind": {
          "const": "task_state_transition"
        },
        "issued_at": {
          "$ref": "#/$defs/timestamp"
        },
        "original_provider_close_event": {
          "$ref": "#/$defs/raw_file"
        },
        "provider_attestation_keyring_digest": {
          "$ref": "#/$defs/digest"
        },
        "provider_event": {
          "$ref": "#/$defs/closed_provider_event"
        },
        "signer_identity": {
          "$ref": "#/$defs/nonempty"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "subject_digests": {
          "items": false,
          "maxItems": 6,
          "minItems": 6,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "predecessor_candidate_identity"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "decision_identity"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "role_assignments"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "task_state_policy_registry"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "durable_close_root"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "sha256": {
                  "$ref": "#/$defs/digest"
                },
                "subject": {
                  "const": "original_provider_close_event"
                }
              },
              "required": [
                "subject",
                "sha256"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        },
        "task_state_policy_registry": {
          "$ref": "#/$defs/raw_file"
        },
        "transition_kind": {
          "const": "release_decision_closed"
        }
      },
      "required": [
        "input_kind",
        "transition_kind",
        "decision",
        "authorized_role",
        "conflicts",
        "signer_identity",
        "signing_method",
        "authority_policy_digest",
        "provider_attestation_keyring_digest",
        "issued_at",
        "expires_at",
        "provider_event",
        "original_provider_close_event",
        "task_state_policy_registry",
        "subject_digests"
      ],
      "type": "object"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "milestone": {
      "enum": [
        "v0.4",
        "v0.5",
        "v0.6",
        "v0.7",
        "v0.8",
        "v0.9",
        "v1.0"
      ]
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "ordinary_protected_input_data": {
      "additionalProperties": false,
      "not": {
        "anyOf": [
          {
            "properties": {
              "decision": {
                "const": "CLOSED"
