        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "role": {
          "enum": [
            "release_operator",
            "non_author_reviewer",
            "infrastructure_owner",
            "publisher",
            "independent_assurance_verifier"
          ]
        }
      },
      "required": [
        "actor_id",
        "backup_actor_id",
        "conflict_free",
        "provenance_digest",
        "provider",
        "role"
