      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
