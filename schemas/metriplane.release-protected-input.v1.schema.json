          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "uuid": {
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-protected-input.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "transition_kind": {
                "const": "release_decision_closed"
              }
            },
            "required": [
              "transition_kind"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "signatures": {
            "minItems": 1
          },
          "status": {
            "const": "PASS"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data": {
            "properties": {
              "input_kind": {
                "const": "role_assignment"
              }
            },
            "required": [
              "input_kind"
            ]
          }
