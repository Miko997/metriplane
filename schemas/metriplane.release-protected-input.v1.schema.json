              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ],
              "type": "object"
            }
          ]
        },
        "infrastructure_owner": {
          "$ref": "#/$defs/role_binding"
        },
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "non_author_reviewer": {
          "$ref": "#/$defs/role_binding"
        },
        "non_author_reviewer_id": {
          "$ref": "#/$defs/nonempty"
        },
        "operator": {
          "$ref": "#/$defs/role_binding"
        },
        "provider_attestation_keyring_digest": {
          "$ref": "#/$defs/digest"
        },
        "publisher": {
          "$ref": "#/$defs/role_binding"
        },
        "publisher_id": {
          "$ref": "#/$defs/nonempty"
        },
        "release_context_digest": {
          "$ref": "#/$defs/digest"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "task_id": {
          "const": "MP2-007"
        },
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "author_id",
        "author_provider",
        "authority_policy_digest",
        "authorized_executor_id",
        "independent_assurance",
        "infrastructure_owner",
        "milestone",
        "non_author_reviewer",
        "non_author_reviewer_id",
        "operator",
        "provider_attestation_keyring_digest",
        "publisher",
