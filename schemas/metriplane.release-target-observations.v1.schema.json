{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal payload_digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.[0-9]+$",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-target-observations.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "api_version",
              "captured_at",
              "observation_digest",
              "provider",
              "registry_digest",
              "targets"
            ]
          },
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-target-observations. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "$ref": "#/$defs/nonempty"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "provider": {
          "$ref": "#/$defs/nonempty"
        },
        "registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "targets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "artifacts": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "expected_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "name": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "observed_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "size": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "expected_digest",
                    "name",
                    "observed_digest",
                    "size"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              },
              "raw_result_digest": {
                "$ref": "#/$defs/digest"
              },
              "state": {
                "enum": [
                  "unused",
                  "occupied",
                  "partial",
                  "unknown"
                ]
              },
              "target_id": {
                "$ref": "#/$defs/identifier"
              },
              "version": {
                "$ref": "#/$defs/version"
              }
            },
            "required": [
              "artifacts",
              "raw_result_digest",
              "state",
              "target_id",
              "version"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "tool": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "required": [
        "observations",
        "tool"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-target-observations"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-target-observations record",
  "type": "object",
  "x-metriplane-live-required": [
    "api_version",
    "captured_at",
    "observation_digest",
    "provider",
    "registry_digest",
    "targets"
  ],
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == payload_digest",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
