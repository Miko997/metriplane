{
  "$comment": "Prospective S3A supplied-input/schema projection. No native implementation, live approval or release qualification is claimed.",
  "$defs": {
    "canonical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "historical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "historical_release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "record_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-target-observations.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "api_version",
              "captured_at",
              "observation_digest",
              "provider",
              "registry_digest",
              "targets"
            ]
          },
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-target-observations. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "api_version": {
          "$ref": "#/$defs/nonempty"
        },
        "capture_phase": {
          "const": "prebuild"
        },
        "captured_at": {
          "$ref": "#/$defs/timestamp"
        },
        "invocation_root_locator": {
          "const": "invocations"
        },
        "observation_digest": {
          "$ref": "#/$defs/digest"
        },
        "observations": {
          "items": {
            "$ref": "#/$defs/raw_file"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "original_registry": {
          "$ref": "#/$defs/record_file"
        },
        "original_release_context": {
          "additionalProperties": false,
          "properties": {
            "original_file": {
              "$ref": "#/$defs/record_file"
            },
            "record_digest": {
              "$ref": "#/$defs/digest"
            },
            "record_type": {
              "const": "release-context"
            }
          },
          "required": [
            "record_type",
            "record_digest",
            "original_file"
          ],
          "type": "object"
        },
        "producer_intent_digest": {
          "$ref": "#/$defs/digest"
        },
        "provider": {
          "$ref": "#/$defs/nonempty"
        },
        "registry_digest": {
          "$ref": "#/$defs/digest"
        },
        "targets": {
          "items": {
            "additionalProperties": false,
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "unused"
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                "then": {
                  "properties": {
                    "artifacts": {
                      "maxItems": 0
                    }
                  }
                }
              }
            ],
            "properties": {
              "artifacts": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "expected_digest": {
                      "type": "null"
                    },
                    "name": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "observed_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "original_read_back": {
                      "$ref": "#/$defs/raw_file"
                    },
                    "size": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "expected_digest",
                    "name",
                    "observed_digest",
                    "size",
                    "original_read_back"
                  ],
                  "type": "object"
                },
                "minItems": 0,
                "type": "array",
                "uniqueItems": true
              },
              "raw_result_digest": {
                "$ref": "#/$defs/digest"
              },
              "state": {
                "enum": [
                  "unused",
                  "occupied",
                  "partial",
                  "unknown"
                ]
              },
              "target_id": {
                "enum": [
                  "github-release",
                  "pypi",
                  "testpypi"
                ]
              },
              "version": {
                "$ref": "#/$defs/canonical_package_version"
              }
            },
            "required": [
              "artifacts",
              "raw_result_digest",
              "state",
              "target_id",
              "version"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "tool": {
          "const": "capture_release_target_observations.py"
        }
      },
      "required": [
        "api_version",
        "capture_phase",
        "captured_at",
        "invocation_root_locator",
        "observation_digest",
        "observations",
        "original_registry",
        "original_release_context",
        "producer_intent_digest",
        "provider",
        "registry_digest",
        "targets",
        "tool"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-target-observations"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "const": []
    },
    "status": {
      "const": "PASS"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-target-observations record",
  "type": "object",
  "x-metriplane-live-required": [
    "api_version",
    "captured_at",
    "observation_digest",
    "provider",
    "registry_digest",
    "targets"
  ],
  "x-metriplane-origin": {
    "kind": "CLI_PRODUCED_RECORD",
    "producer": "capture_release_target_observations.py",
    "production_implementation": false,
    "stage": "capture-release-target-observations",
    "terminal_digest_in_output": false
  },
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes"
  ],
  "x-metriplane-semantic-contract": "semantic-contract.md; full current controller integration and original native proof replay required; structure alone is insufficient"
}
