{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "terminal_result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "CANCELLED",
        "SKIPPED"
      ]
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-cell-result.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-cell-result. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "artifact_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_id": {
          "$ref": "#/$defs/identifier"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "cell_id": {
          "$ref": "#/$defs/identifier"
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "counts": {
          "additionalProperties": false,
          "properties": {
            "deselected": {
              "minimum": 0,
              "type": "integer"
            },
            "failed": {
              "minimum": 0,
              "type": "integer"
            },
            "passed": {
              "minimum": 0,
              "type": "integer"
            },
            "retried": {
              "minimum": 0,
              "type": "integer"
            },
            "skipped": {
              "minimum": 0,
              "type": "integer"
            },
            "xfailed": {
              "minimum": 0,
              "type": "integer"
            },
            "xpassed": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "deselected",
            "failed",
            "passed",
            "retried",
            "skipped",
            "xfailed",
            "xpassed"
          ],
          "type": "object"
        },
        "environment_id": {
          "$ref": "#/$defs/identifier"
        },
        "junit_digest": {
          "$ref": "#/$defs/digest"
        },
        "obligation_ids": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "profile_id": {
          "$ref": "#/$defs/identifier"
        },
        "result": {
          "$ref": "#/$defs/terminal_result"
        },
        "runner_identity": {
          "$ref": "#/$defs/nonempty"
        },
        "scenario_ids": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "stderr_digest": {
          "$ref": "#/$defs/digest"
        },
        "stdout_digest": {
          "$ref": "#/$defs/digest"
        },
        "unexpected_outcomes": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "artifact_digest",
        "attempt_id",
        "candidate_digest",
        "cell_id",
        "completed_at",
        "counts",
        "environment_id",
        "junit_digest",
        "obligation_ids",
        "plan_digest",
        "profile_id",
        "result",
        "runner_identity",
        "scenario_ids",
        "started_at",
        "stderr_digest",
        "stdout_digest",
        "unexpected_outcomes"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-cell-result"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-cell-result record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
