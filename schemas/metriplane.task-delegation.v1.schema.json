{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriplane.com/schemas/metriplane.task-delegation.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "subject", "subject_digest", "signature"],
  "properties": {
    "schema_version": {"const": "metriplane.task-delegation.v1"},
    "synthetic": {"type": "boolean"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "delegation_id",
        "grantor",
        "delegate",
        "scope",
        "tracker",
        "issued_at",
        "expires_at",
        "max_snapshot_age_seconds",
        "tracker_snapshot_digest",
        "signing_key_id"
      ],
      "properties": {
        "delegation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "grantor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "actor_id", "role"],
          "properties": {
            "provider": {"enum": ["github", "linear"]},
            "actor_id": {"type": "string", "minLength": 1},
            "role": {"const": "repository_owner"}
          }
        },
        "delegate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "executor_id"],
          "properties": {
            "kind": {"const": "codex_goal"},
            "executor_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "authority",
            "repository",
            "project_id",
            "task_id",
            "linear_issue",
            "base_sha",
            "base_tree"
          ],
          "properties": {
            "authority": {"type": "string", "minLength": 1},
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "project_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            "task_id": {"type": "string", "pattern": "^MP2-[0-9]{3}$"},
            "linear_issue": {"type": "string", "pattern": "^MET-[0-9]+$"},
            "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
            "base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
          }
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "event_id", "event_cursor"],
          "properties": {
            "provider": {"const": "linear"},
            "event_id": {"type": "string", "minLength": 1},
            "event_cursor": {"type": "string", "minLength": 1}
          }
        },
        "issued_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "expires_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
        "max_snapshot_age_seconds": {"type": "integer", "minimum": 60, "maximum": 86400},
        "tracker_snapshot_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signing_key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "subject_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "actor_id", "key_id", "signature"],
      "properties": {
        "provider": {"enum": ["github", "linear"]},
        "actor_id": {"type": "string", "minLength": 1},
        "key_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    }
  }
}
