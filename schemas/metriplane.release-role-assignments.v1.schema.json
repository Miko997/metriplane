                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ],
              "type": "object"
            }
          ]
        },
        "infrastructure_owner": {
          "$ref": "#/$defs/role_binding"
        },
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "non_author_reviewer": {
          "$ref": "#/$defs/role_binding"
        },
        "non_author_reviewer_id": {
          "$ref": "#/$defs/nonempty"
        },
        "operator": {
          "$ref": "#/$defs/role_binding"
        },
        "provider_attestation_keyring_digest": {
          "$ref": "#/$defs/digest"
        },
        "publisher": {
          "$ref": "#/$defs/role_binding"
        },
        "publisher_id": {
