{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "milestone": {
      "enum": [
        "v0.4",
        "v0.5",
        "v0.6",
        "v0.7",
        "v0.8",
        "v0.9",
        "v1.0"
      ]
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "role_assignment_payload": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "independent_assurance": {
                "additionalProperties": false,
                "properties": {
                  "applicability": {
                    "const": "not_applicable"
                  }
                },
                "required": [
                  "applicability"
                ],
                "type": "object"
              }
            }
          },
          "if": {
            "properties": {
              "milestone": {
                "enum": [
                  "v0.9",
                  "v1.0"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "independent_assurance": {
                "properties": {
                  "applicability": {
                    "const": "required"
                  }
                }
              }
            }
          }
        }
      ],
      "properties": {
        "author_id": {
          "$ref": "#/$defs/nonempty"
        },
        "author_provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_executor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "independent_assurance": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "required"
                },
                "binding": {
                  "$ref": "#/$defs/role_binding"
                }
