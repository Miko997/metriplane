        },
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "author_id",
        "author_provider",
        "authority_policy_digest",
        "authorized_executor_id",
        "independent_assurance",
        "infrastructure_owner",
        "milestone",
        "non_author_reviewer",
        "non_author_reviewer_id",
        "operator",
        "provider_attestation_keyring_digest",
        "publisher",
        "publisher_id",
        "release_context_digest",
        "run_id",
        "signing_method",
