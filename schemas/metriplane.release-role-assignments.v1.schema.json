{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "milestone": {
      "enum": [
        "v0.4",
        "v0.5",
        "v0.6",
        "v0.7",
        "v0.8",
        "v0.9",
        "v1.0"
      ]
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "role_binding": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "backup_actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "conflict_free": {
          "const": true
        },
        "provenance_digest": {
          "$ref": "#/$defs/digest"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "role": {
          "enum": [
            "release_operator",
            "non_author_reviewer",
            "infrastructure_owner",
            "publisher",
            "independent_assurance_verifier"
          ]
        }
      },
      "required": [
        "actor_id",
        "backup_actor_id",
        "conflict_free",
        "provenance_digest",
        "provider",
        "role"
      ],
      "type": "object"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-role-assignments.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "required": [
              "author_provider",
              "authority_policy_digest",
              "independent_assurance",
              "infrastructure_owner",
              "milestone",
              "non_author_reviewer",
              "operator",
              "provider_attestation_keyring_digest",
              "publisher",
              "run_id",
              "signing_method",
              "valid_from",
              "valid_until"
            ]
          },
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-role-assignments. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "author_id": {
          "$ref": "#/$defs/nonempty"
        },
        "author_provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "authority_policy_digest": {
          "$ref": "#/$defs/digest"
        },
        "authorized_executor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "independent_assurance": {
          "oneOf": [
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "required"
                },
                "binding": {
                  "$ref": "#/$defs/role_binding"
                }
              },
              "required": [
                "applicability",
                "binding"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "applicability": {
                  "const": "not_applicable"
                }
              },
              "required": [
                "applicability"
              ],
              "type": "object"
            }
          ]
        },
        "infrastructure_owner": {
          "$ref": "#/$defs/role_binding"
        },
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "non_author_reviewer": {
          "$ref": "#/$defs/role_binding"
        },
        "non_author_reviewer_id": {
          "$ref": "#/$defs/nonempty"
        },
        "operator": {
          "$ref": "#/$defs/role_binding"
        },
        "publisher": {
          "$ref": "#/$defs/role_binding"
        },
        "publisher_id": {
          "$ref": "#/$defs/nonempty"
        },
        "provider_attestation_keyring_digest": {
          "$ref": "#/$defs/digest"
        },
        "run_id": {
          "$ref": "#/$defs/identifier"
        },
        "signing_method": {
          "const": "provider-attestation-v1"
        },
        "task_id": {
          "const": "MP2-007"
        },
        "valid_from": {
          "$ref": "#/$defs/timestamp"
        },
        "valid_until": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "author_id",
        "authorized_executor_id",
        "non_author_reviewer_id",
        "publisher_id",
        "task_id"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-role-assignments"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-role-assignments record",
  "type": "object",
  "x-metriplane-live-required": [
    "author_provider",
    "authority_policy_digest",
    "independent_assurance",
    "infrastructure_owner",
    "milestone",
    "non_author_reviewer",
    "operator",
    "provider_attestation_keyring_digest",
    "publisher",
    "run_id",
    "signing_method",
    "valid_from",
    "valid_until"
  ],
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
