{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal payload_digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-promotion-plan.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-promotion-plan. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "approval_digest": {
          "$ref": "#/$defs/digest"
        },
        "attempt_index_checkpoint_digest": {
          "$ref": "#/$defs/digest"
        },
        "candidate_digest": {
          "$ref": "#/$defs/digest"
        },
        "expires_at": {
          "$ref": "#/$defs/timestamp"
        },
        "gate_instance_digest": {
          "$ref": "#/$defs/digest"
        },
        "linear_snapshot_digest": {
          "$ref": "#/$defs/digest"
        },
        "mode": {
          "const": "dry_run"
        },
        "mutation_started": {
          "const": false
        },
        "plan_digest": {
          "$ref": "#/$defs/digest"
        },
        "prepromotion_controls_digest": {
          "$ref": "#/$defs/digest"
        },
        "publisher_actions": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "qualification_digest": {
          "$ref": "#/$defs/digest"
        },
        "record_kind": {
          "const": "promotion_plan"
        },
        "targets": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "expected_outputs": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "expected_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "name": {
                      "$ref": "#/$defs/nonempty"
                    },
                    "observed_digest": {
                      "$ref": "#/$defs/digest"
                    },
                    "size": {
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "expected_digest",
                    "name",
                    "observed_digest",
                    "size"
                  ],
                  "type": "object"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "expected_state_digest": {
                "$ref": "#/$defs/digest"
              },
              "target_id": {
                "$ref": "#/$defs/identifier"
              }
            },
            "required": [
              "expected_outputs",
              "expected_state_digest",
              "target_id"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "approval_digest",
        "attempt_index_checkpoint_digest",
        "candidate_digest",
        "expires_at",
        "gate_instance_digest",
        "linear_snapshot_digest",
        "mode",
        "mutation_started",
        "plan_digest",
        "prepromotion_controls_digest",
        "publisher_actions",
        "qualification_digest",
        "record_kind",
        "targets"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-promotion-plan"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-promotion-plan record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == payload_digest",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
