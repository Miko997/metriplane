    "obligations": {
      "items": {
        "$comment": "Explicit empty mapping arrays are representable only for UNRESOLVED implementation. They confer no coverage. Determine current applicability from complete authoritative BOM/owner/first-required release before inspecting mappings; retain a blocker per missing dimension and prohibit dependent unit/coverage materialization. CONFIGURED requires every mapping nonempty.",
        "additionalProperties": false,
        "allOf": [
          {
