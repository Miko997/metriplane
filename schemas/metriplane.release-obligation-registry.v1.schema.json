          "const": "ALLOW_EMPTY_DELTA_MAP_KEEP_BASELINE"
        },
        "missing_required_mapping": {
          "const": "BLOCKED"
        },
        "product_failure": {
          "const": "NEW_CANDIDATE_COMPLETE_QUALIFICATION_RESTART"
