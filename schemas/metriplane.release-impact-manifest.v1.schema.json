{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal payload_digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "git_sha": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "milestone": {
      "enum": [
        "v0.4",
        "v0.5",
        "v0.6",
        "v0.7",
        "v0.8",
        "v0.9",
        "v1.0"
      ]
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.[0-9]+$",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-impact-manifest.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-impact-manifest. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "author_id": {
          "$ref": "#/$defs/nonempty"
        },
        "base_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "changes": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "capability_ids": {
                "items": {
                  "$ref": "#/$defs/nonempty"
                },
                "minItems": 1,
                "type": "array",
                "uniqueItems": true
              },
              "change_type": {
                "enum": [
                  "added",
                  "modified",
                  "deleted",
                  "renamed"
                ]
              },
              "classification": {
                "$ref": "#/$defs/nonempty"
              },
              "justification": {
                "$ref": "#/$defs/nonempty"
              },
              "path": {
                "$ref": "#/$defs/nonempty"
              }
            },
            "required": [
              "capability_ids",
              "change_type",
              "classification",
              "justification",
              "path"
            ],
            "type": "object"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "head_sha": {
          "$ref": "#/$defs/git_sha"
        },
        "manifest_digest": {
          "$ref": "#/$defs/digest"
        },
        "milestone": {
          "$ref": "#/$defs/milestone"
        },
        "release_tag": {
          "$ref": "#/$defs/version"
        },
        "source_freeze_digest": {
          "$ref": "#/$defs/digest"
        },
        "target_resolution_digest": {
          "$ref": "#/$defs/digest"
        },
        "unclassified_paths": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "maxItems": 0,
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "author_id",
        "base_sha",
        "changes",
        "head_sha",
        "manifest_digest",
        "milestone",
        "release_tag",
        "source_freeze_digest",
        "target_resolution_digest",
        "unclassified_paths"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-impact-manifest"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-impact-manifest record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == payload_digest",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
