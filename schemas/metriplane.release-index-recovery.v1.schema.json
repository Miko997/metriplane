        "scope_kind": {
          "enum": [
            "release_staging",
            "release_candidate",
            "evaluation_staging",
            "evaluation_candidate",
            "release_completion"
          ]
        },
        "task_state_invalidation_reason": {
          "enum": [
            null,
            "expired",
            "state_changed"
          ]
        }
      },
      "required": [
