{
  "$comment": "Prospective S3A supplied-input/schema projection. No native implementation, live approval or release qualification is claimed.",
  "$defs": {
    "canonical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "historical_package_version": {
      "pattern": "^(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "historical_release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?:\\.post(?:0|[1-9][0-9]*))?(?![\\s\\S])",
      "type": "string"
    },
    "identifier": {
      "maxLength": 160,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$",
      "type": "string"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "record_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-index-recovery.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-index-recovery. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "original_entry_disposition": {
                "const": "never_committed"
              }
