{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriplane.com/schemas/metriplane.migration-delta.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "base_sha", "head_sha", "author_id", "changed_paths", "changes"],
  "properties": {
    "schema_version": {"const": "metriplane.migration-delta.v1"},
    "task_id": {"const": "MP2-017"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "author_id": {"type": "string", "minLength": 1},
    "changed_paths": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}
    },
    "changes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["stable_id", "kind", "before_sha256", "after_sha256", "supersedes", "replacements", "compatibility_window"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["semantic", "golden", "test_obligation"]},
          "before_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "after_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
          "supersedes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "replacements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "compatibility_window": {
            "type": "object", "additionalProperties": false,
            "required": ["first_release", "last_release", "disposition", "reason"],
            "properties": {
              "first_release": {"type": "string", "minLength": 1},
              "last_release": {"type": ["string", "null"]},
                                        "disposition": {"enum": ["preserved", "deprecated", "removed_after_window"]},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
