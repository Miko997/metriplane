  "$id": "https://metriplane.com/schemas/metriplane.release-attempt-index.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-attempt-index. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "oneOf": [
        {
          "$ref": "#/$defs/update_receipt_data"
        },
        {
          "$ref": "#/$defs/complete_export_data"
        }
      ]
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-attempt-index"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "const": "PASS"
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-attempt-index record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == sha256(canonical_json(decision_envelope))",
    "all referenced digests resolve to the exact retained subject bytes",
    "Exactly update_receipt from update_release_attempt_index or complete_export from export_release_attempt_index; require their fixed producer/stage and complete original journal. Missing/mixed kinds or receipt-as-export are invalid.",
    "genesis_digest=R(exact independently approved original genesis bytes). Generation0 through_head is this genesis digest. First committed previous_head is null only at generation1 with this independently bound genesis; later previous_head is the prior entry digest.",
    "Each native entry projection is derived from original authenticated readback bytes by the exact approved existing adapter. entry_digest=C(complete normalized entry); each receipt committed_head and read_back_digest equal this identity. Native raw-file sha256 remains R(bytes), distinct from that entry identity.",
    "Replay generations1..N and previous heads from original genesis without gaps, forks or duplicate logical operations; original idempotent replay does not allocate a generation. Bind every original receipt/manifest/retention and read back the complete immutable payload closure in both approved independent stores.",
    "Final through_head/generation equal the last entry (or genuine empty genesis) and authenticated original head observation; capture interval encloses the observation. A stale or unbound snapshot cannot authorize a current absence/closure decision.",
    "This complete export proves full index traversal/byte readback, not release qualification. Selected predecessor records still require all original type-specific semantic validators. Unsupported native wire, unknown stage/kind or missing retention/journal closure blocks instead of skipping it.",
    "The ordinary S3A profile does not execute future evaluation/completion workflows; a required unimplemented stage proof remains explicitly blocked."
  ]
}
