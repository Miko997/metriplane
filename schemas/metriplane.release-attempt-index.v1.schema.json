{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal the canonical decision-envelope digest, and verify all referenced records by digest.",
  "$defs": {
    "complete_export_data": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "entries": {
                "minItems": 1
              }
            }
          },
          "if": {
            "properties": {
              "generation": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      ],
      "properties": {
        "backend_binding_digest": {
          "$ref": "#/$defs/digest"
        },
        "backend_id": {
          "const": "attempt-index"
        },
        "capture_completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "capture_started_at": {
          "$ref": "#/$defs/timestamp"
