{
  "$comment": "Validators must recompute payload_digest and record_id, require every signature subject_digest to equal payload_digest, and verify all referenced records by digest.",
  "$defs": {
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "input_ref": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "schema_id": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "sha256",
        "schema_id"
      ],
      "type": "object"
    },
    "live_signature": {
      "additionalProperties": false,
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "const": "provider-attestation-v1"
        },
        "provider": {
          "enum": [
            "github",
            "linear"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "const": false
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "nullable_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "terminal_result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "CANCELLED",
        "SKIPPED"
      ]
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://metriplane.com/schemas/metriplane.release-stage-invocation.v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic": {
            "const": false
          }
        },
        "required": [
          "synthetic"
        ]
      },
      "then": {
        "properties": {
          "data": {},
          "signatures": {
            "items": {
              "$ref": "#/$defs/live_signature"
            }
          }
        }
      }
    }
  ],
  "description": "Closed subject-specific contract for release-stage-invocation. Structural validation does not replace canonical digest recomputation, provider authentication, signature verification, compare-and-swap read-back, or cross-record semantic validation.",
  "properties": {
    "data": {
      "additionalProperties": false,
      "properties": {
        "argv": {
          "items": {
            "$ref": "#/$defs/nonempty"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "completed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "exit_code": {
          "minimum": 0,
          "type": "integer"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/input_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "invocation_digest": {
          "$ref": "#/$defs/digest"
        },
        "outputs": {
          "items": {
            "$ref": "#/$defs/input_ref"
          },
          "minItems": 0,
          "type": "array",
          "uniqueItems": true
        },
        "previous_invocation_digest": {
          "$ref": "#/$defs/nullable_digest"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "stderr_digest": {
          "$ref": "#/$defs/digest"
        },
        "stdout_digest": {
          "$ref": "#/$defs/digest"
        },
        "terminal_status": {
          "$ref": "#/$defs/terminal_result"
        },
        "tool": {
          "$ref": "#/$defs/nonempty"
        },
        "tool_version": {
          "$ref": "#/$defs/nonempty"
        }
      },
      "required": [
        "argv",
        "completed_at",
        "exit_code",
        "inputs",
        "invocation_digest",
        "outputs",
        "previous_invocation_digest",
        "started_at",
        "stderr_digest",
        "stdout_digest",
        "terminal_status",
        "tool",
        "tool_version"
      ],
      "type": "object"
    },
    "invocation_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$",
      "type": "string"
    },
    "payload_digest": {
      "$ref": "#/$defs/digest"
    },
    "record_id": {
      "$ref": "#/$defs/digest"
    },
    "record_type": {
      "const": "release-stage-invocation"
    },
    "schema_version": {
      "const": "metriplane.release-record.v1"
    },
    "sequence": {
      "minimum": 1,
      "type": "integer"
    },
    "signatures": {
      "items": {
        "$ref": "#/$defs/signature"
      },
      "maxItems": 16,
      "type": "array",
      "uniqueItems": true
    },
    "status": {
      "enum": [
        "BLOCKED",
        "CANCELLED",
        "FAIL",
        "INVALIDATED",
        "OPEN",
        "PASS",
        "READY",
        "SKIPPED"
      ]
    },
    "synthetic": {
      "type": "boolean"
    }
  },
  "required": [
    "data",
    "invocation_id",
    "payload_digest",
    "record_id",
    "record_type",
    "schema_version",
    "sequence",
    "signatures",
    "status",
    "synthetic"
  ],
  "title": "Metriplane release-stage-invocation record",
  "type": "object",
  "x-metriplane-semantic-checks": [
    "payload_digest == sha256(canonical_json(data))",
    "record_id == sha256(canonical_json(record_without_record_id))",
    "signature.subject_digest == payload_digest",
    "all referenced digests resolve to the exact retained subject bytes"
  ]
}
