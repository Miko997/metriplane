      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "nonempty": {
      "minLength": 1,
      "pattern": ".*\\S.*",
      "type": "string"
    },
    "raw_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "record_file": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "path": {
          "$ref": "#/$defs/relative_path"
        },
        "sha256": {
          "$ref": "#/$defs/digest"
        }
      },
      "required": [
        "path",
        "bytes",
        "sha256"
      ],
      "type": "object"
    },
    "relative_path": {
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\\\\)(?!.*[\\u0000-\\u001f]).+$",
      "type": "string"
    },
    "release_tag": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    },
    "signature": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": true
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "test-sha256-v1"
              },
              "provider": {
                "const": "test-fixture"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "synthetic": {
                "const": false
              }
            },
            "required": [
              "synthetic"
            ]
          },
          "then": {
            "properties": {
              "algorithm": {
                "const": "provider-attestation-v1"
              },
              "provider": {
                "enum": [
                  "github",
                  "linear"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "actor_id": {
          "$ref": "#/$defs/nonempty"
        },
        "algorithm": {
          "enum": [
            "provider-attestation-v1",
            "test-sha256-v1"
          ]
        },
        "provider": {
          "enum": [
            "github",
            "linear",
            "test-fixture"
          ]
        },
        "signature": {
          "minLength": 16,
          "type": "string"
        },
        "subject_digest": {
          "$ref": "#/$defs/digest"
        },
        "synthetic": {
          "type": "boolean"
        }
      },
      "required": [
        "actor_id",
        "algorithm",
        "provider",
        "signature",
        "subject_digest",
        "synthetic"
      ],
      "type": "object"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    },
    "version": {
      "pattern": "^v(?:0\\.[3-9]|1\\.0)\\.(?:0|[1-9][0-9]*)(?![\\s\\S])",
      "type": "string"
    }
  },
