{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metriplane.com/schemas/metriplane.task-delegation.v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "program_grant", "subject", "subject_digest", "delegate_signature", "attestor_signature"],
  "properties": {
    "schema_version": {"const": "metriplane.task-delegation.v2"},
    "synthetic": {"type": "boolean"},
    "program_grant": {"type": "object"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["delegation_id", "program_grant_id", "grantor", "delegate", "scope", "tracker", "issued_at", "expires_at", "tracker_snapshot_digest", "delegate_key_id", "attestor_key_id"],
      "properties": {
        "delegation_id": {"$ref": "#/$defs/digest"},
        "program_grant_id": {"$ref": "#/$defs/digest"},
        "grantor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "actor_id", "role"],
          "properties": {
            "provider": {"enum": ["github", "linear"]},
            "actor_id": {"type": "string", "minLength": 1},
            "role": {"const": "repository_owner"}
          }
        },
        "delegate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "executor_id"],
          "properties": {
            "kind": {"const": "codex_goal"},
            "executor_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
          }
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authority", "repository", "project_id", "task_id", "linear_issue", "base_sha", "base_tree"],
          "properties": {
            "authority": {"const": "implementation"},
            "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
            "project_id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"},
            "task_id": {"type": "string", "pattern": "^MP2-[0-9]{3}$"},
            "linear_issue": {"type": "string", "pattern": "^MET-[0-9]+$"},
            "base_sha": {"$ref": "#/$defs/sha"},
            "base_tree": {"$ref": "#/$defs/sha"}
          }
        },
        "tracker": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "event_id", "event_cursor"],
          "properties": {
            "provider": {"const": "linear"},
            "event_id": {"type": "string", "minLength": 1},
            "event_cursor": {"type": "string", "minLength": 1}
          }
        },
        "issued_at": {"$ref": "#/$defs/time"},
        "expires_at": {"$ref": "#/$defs/time"},
        "tracker_snapshot_digest": {"$ref": "#/$defs/digest"},
        "delegate_key_id": {"$ref": "#/$defs/digest"},
        "attestor_key_id": {"$ref": "#/$defs/digest"}
      }
    },
    "subject_digest": {"$ref": "#/$defs/digest"},
    "delegate_signature": {"$ref": "#/$defs/signature"},
    "attestor_signature": {"$ref": "#/$defs/signature"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "actor_id", "key_id", "signature"],
      "properties": {
        "provider": {"enum": ["codex_goal", "metriplane-health"]},
        "actor_id": {"type": "string", "minLength": 1},
        "key_id": {"$ref": "#/$defs/digest"},
        "signature": {"type": "string", "pattern": "^[0-9a-f]{128}$"}
      }
    }
  }
}
