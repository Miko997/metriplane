{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_mode": {"enum": ["independent-review", "single-maintainer-owner-emergency"]},
    "approval_id": {"minLength": 1, "type": "string"},
    "approval_provider": {"const": "github"},
    "author": {"minLength": 1, "type": "string"},
    "author_id": {"minLength": 1, "type": "string"},
    "captured_at": {"format": "date-time", "type": "string"},
    "changed_paths": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "head_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "incident_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "issue": {"pattern": "^[A-Z]+-[0-9]+$", "type": "string"},
    "merge_commit_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "merge_parent_shas": {"items": {"pattern": "^[0-9a-f]{40}$", "type": "string"}, "minItems": 2, "type": "array", "uniqueItems": true},
    "merge_tree_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "pull_request": {"pattern": "^[1-9][0-9]*$", "type": "string"},
    "repository": {"pattern": "^[^/]+/[^/]+$", "type": "string"},
    "reviewed_tree_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "reviewer": {"minLength": 1, "type": "string"},
    "reviewer_id": {"minLength": 1, "type": "string"},
    "reviewer_permission": {"enum": ["admin", "maintain", "write"]},
    "schema_version": {"const": 1},
    "state": {"enum": ["APPROVED", "OWNER_EMERGENCY"]}
  },
  "required": ["authorization_mode", "approval_id", "approval_provider", "author", "author_id", "captured_at", "changed_paths", "head_sha", "incident_digest", "issue", "merge_commit_sha", "merge_parent_shas", "merge_tree_sha", "pull_request", "repository", "reviewed_tree_sha", "reviewer", "reviewer_id", "reviewer_permission", "schema_version", "state"],
  "type": "object"
}
