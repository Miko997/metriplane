{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "cadence": {"enum": ["candidate", "protected-main", "nightly", "weekly"]},
    "conclusion": {"enum": ["success", "failure"]},
    "obligations": {
      "items": {
        "additionalProperties": false,
        "properties": {"id": {"minLength": 1, "type": "string"}, "result": {"enum": ["success", "failure"]}},
        "required": ["id", "result"],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "recorded_at": {"format": "date-time", "type": "string"},
    "run_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"}
  },
  "required": ["cadence", "conclusion", "obligations", "recorded_at", "run_id", "schema_version", "sha"],
  "type": "object"
}
