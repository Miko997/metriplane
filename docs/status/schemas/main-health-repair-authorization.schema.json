{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "approval_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "approval_id": {"minLength": 1, "type": "string"},
    "approval_provider": {"enum": ["github", "linear"]},
    "allowed_paths": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "author": {"minLength": 1, "type": "string"},
    "author_id": {"minLength": 1, "type": "string"},
    "changed_paths_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "expires_at": {"format": "date-time", "type": "string"},
    "failing_obligations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array", "uniqueItems": true},
    "issue": {"pattern": "^[A-Z]+-[0-9]+$", "type": "string"},
    "proposed_repair_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "pull_request": {"pattern": "^[1-9][0-9]*$", "type": "string"},
    "repository": {"pattern": "^[^/]+/[^/]+$", "type": "string"},
    "required_cadences": {"items": {"enum": ["nightly", "weekly"]}, "type": "array", "uniqueItems": true},
    "reviewer": {"minLength": 1, "type": "string"},
    "reviewer_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1}
  },
  "required": ["approval_digest", "approval_id", "approval_provider", "allowed_paths", "author", "author_id", "changed_paths_digest", "expires_at", "failing_obligations", "issue", "proposed_repair_sha", "pull_request", "repository", "required_cadences", "reviewer", "reviewer_id", "schema_version"],
  "type": "object"
}
