{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_mode": {"enum": ["independent-review", "single-maintainer-owner-emergency"]},
    "authorization_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "incident_digest": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "policy_amendment_digest": {"oneOf": [{"pattern": "^[0-9a-f]{64}$", "type": "string"}, {"type": "null"}]},
    "repaired_main_sha": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "resolved_at": {"format": "date-time", "type": "string"},
    "schema_version": {"const": 1}
  },
  "required": ["authorization_mode", "authorization_digest", "incident_digest", "policy_amendment_digest", "repaired_main_sha", "resolved_at", "schema_version"],
  "type": "object"
}
