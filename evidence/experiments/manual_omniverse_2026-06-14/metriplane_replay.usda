#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Z"
    timeCodesPerSecond = 30.0
    startTimeCode = 0
    endTimeCode = 4
    customLayerData = {
        string metriplane_run_id = "atlas_assembly_missing_tool_001"
        string metriplane_source = "web/dashboard/atlas_run/evidence_bundles/INC-0001"
        string metriplane_coordinate_mapping = "USD_X=X, USD_Y=Y, USD_Z=0 (2D floor)"
    }
)

def Xform "World"
{
    def Cube "Floor"
    {
        double size = 1
        float3 xformOp:scale = (20, 20, 0.01)
        uniform token[] xformOpOrder = ["xformOp:scale"]
        color3f[] primvars:displayColor = [(0.15, 0.15, 0.18)]
    }

    def Xform "Objects"
    {
        def Sphere "marker_1"
        {
            double radius = 0.2
            custom string metriplane:object_id = "marker_1"
            custom string metriplane:type = "unknown"
            color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
            double3 xformOp:translate.timeSamples = {
                0: (0.8, 0.4, 0),
            }
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "marker_12"
        {
            double radius = 0.2
            custom string metriplane:object_id = "marker_12"
            custom string metriplane:type = "unknown"
            color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
            double3 xformOp:translate.timeSamples = {
                4: (2.6, 0.7, 0),
            }
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "marker_21"
        {
            double radius = 0.2
            custom string metriplane:object_id = "marker_21"
            custom string metriplane:type = "unknown"
            color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
            double3 xformOp:translate.timeSamples = {
                4: (2.5, 0.9, 0),
            }
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
        def Sphere "marker_7"
        {
            double radius = 0.2
            custom string metriplane:object_id = "marker_7"
            custom string metriplane:type = "unknown"
            color3f[] primvars:displayColor = [(0.6, 0.6, 0.6)]
            double3 xformOp:translate.timeSamples = {
                1: (2.8, 0.8, 0),
                2: (2.9, 0.8, 0),
                3: (3.0, 0.8, 0),
                4: (3.1, 0.8, 0),
            }
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "Incidents"
    {
        def Cube "INC_0001"
        {
            double size = 0.4
            color3f[] primvars:displayColor = [(1, 0, 0)]
            custom string metriplane:incident_id = "INC-0001"
            custom string metriplane:summary = "Torque driver available before fastening waited because torque_driver_1 was absent."
            float3 xformOp:translate = (0.0, 0.0, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }
}
